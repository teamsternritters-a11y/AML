# ==============================================================================
# Synesis 26 · Fintech #1 — Real-Time Fraud & AML Risk Orchestration
# Root .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# Python & Virtual Environments
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Python packaging & distribution
/build/
develop-eggs/
/dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Linting
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/
nosetests.xml
coverage.xml
*.cover

# Jupyter Notebooks
.ipynb_checkpoints/

# ------------------------------------------------------------------------------
# Backend Artifacts, ML Models & Generated Data
# ------------------------------------------------------------------------------
backend/generated/
backend/models/*.joblib
*.joblib
*.pkl
*.onnx

# Process runtime & PID files
*.pid
.uvicorn.pid

# Logs
logs/
*.log

# ------------------------------------------------------------------------------
# Frontend & Node.js
# ------------------------------------------------------------------------------
node_modules/
frontend/node_modules/
dist/
frontend/dist/
dist-ssr/
frontend/dist-ssr/
.eslintcache

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# Environment Variables & Secrets
# ------------------------------------------------------------------------------
.env
.env.*
*.local
.env.local
.env.development.local
.env.test.local
.env.production.local

# Always allow committing example configuration templates
!.env.example
!frontend/.env.example
!backend/.env.example

# ------------------------------------------------------------------------------
# Operating System & IDE Files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/

# JetBrains / IntelliJ / PyCharm / WebStorm
.idea/
*.iws
*.iml

# Visual Studio Code
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Vim / Emacs swap and backup files
*.swp
*.swo
*~
.#*

# ------------------------------------------------------------------------------
# Antigravity & Agent Caches
# ------------------------------------------------------------------------------
.gemini/
.agents/scratch/
